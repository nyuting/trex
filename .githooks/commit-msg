#!/usr/bin/env bash
# Enforce Conventional Commits: <type>(<scope>)?: <summary>

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_lib.sh
. "${HOOK_DIR}/_lib.sh"

MSG_FILE="$1"
SUBJECT="$(grep -vE '^\s*#' "$MSG_FILE" | grep -vE '^\s*$' | head -n 1 || true)"

# git generates these itself; they are not ours to validate.
case "$SUBJECT" in
    "Merge "*|"Revert "*|"fixup!"*|"squash!"*|"Initial commit") exit 0 ;;
    "") fail "Empty commit message." ;;
esac

TYPES='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
PATTERN="^(${TYPES})(\([a-z0-9][a-z0-9-]*\))?!?: [^ ].{0,71}$"

if ! printf '%s' "$SUBJECT" | grep -qE "$PATTERN"; then
    fail "Commit subject does not follow Conventional Commits." \
         "" \
         "  got:  $SUBJECT" \
         "" \
         "  form: <type>(<scope>)?: <summary>     (summary ≤ 72 chars, no trailing period)" \
         "  type: ${TYPES//|/, }" \
         "  scope: extract, parse, categorize, categories, summary, reconcile, cli, ci, deps, hooks" \
         "" \
         "  good: fix(categories): restore the categorizations lost in c5dabfa" \
         "  good: feat(summary): surface spending the total leaves out"
fi

case "$SUBJECT" in
    *.) fail "Commit subject ends with a period." "  got:  $SUBJECT" ;;
esac

ok "commit message"
